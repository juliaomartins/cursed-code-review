{
  "name": "cursed-code-review",
  "version": "0.1.0",
  "private": true,
  "description": "A haunted code review where every bug is a monster. Kiroween 2026 \u00b7 Costume Contest.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint:a11y": "eslint \"src/**/*.tsx\"",
    "test:scanner": "vitest run src/lib/__tests__/accuracy.test.ts src/lib/__tests__/scanner.test.ts",
    "test:fix-engine": "vitest run src/lib/__tests__/review.test.ts src/lib/__tests__/fixEngine.property.test.ts src/lib/__tests__/fixes.test.ts",
    "test:ui": "vitest run src/components",
    "check:kiro": "node scripts/check-kiro.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:kiro && npm test"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}

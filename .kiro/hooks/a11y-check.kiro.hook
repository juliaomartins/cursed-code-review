{
  "enabled": true,
  "name": "UI component saved → accessibility pass",
  "description": "Checks new UI for real buttons, 44px targets, labels and reduced-motion support.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["src/components/**/*.tsx"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the edited component for accessibility: interactive elements must be <button> or <a>, icon-only buttons need aria-label, touch targets at least 44px, form fields need labels, decorative SVG needs aria-hidden, and animations must respect prefers-reduced-motion. Fix any issue you find."
  }
}

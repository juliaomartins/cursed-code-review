# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
# Without them, public pull requests still work; sign-in, private repos and posting are off.

# Easiest: open /setup on your site, click "Create the GitHub App", then "Copy all".
# Or by hand, from github.com/settings/apps/<your-app> → General
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The app's URL name: github.com/apps/<slug>
GITHUB_APP_SLUG=

# Optional. Random string of at least 32 characters that encrypts the session cookie.
# When empty, a key is derived from the client secret.
# SESSION_SECRET=

# Optional. Fixed public URL (no trailing slash). Defaults to the request's own URL,
# which is what you want on Vercel.
# APP_URL=https://cursed-code-review.vercel.app

# Optional. A fine-grained token with read-only access to public repositories,
# used only when nobody is signed in, to raise GitHub's anonymous rate limit.
# GITHUB_TOKEN=
